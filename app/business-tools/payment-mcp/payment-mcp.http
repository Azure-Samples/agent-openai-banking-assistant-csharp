@PaymentMcp_HostAddress = http://localhost:5002

### Test 1: MCP Server Initialize
POST {{PaymentMcp_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 1,
  "method": "initialize",
  "params": {
    "protocolVersion": "2024-11-05",
    "capabilities": {},
    "clientInfo": {
      "name": "test-client",
      "version": "1.0.0"
    }
  }
}

###

### Test 2: List Available Tools
POST {{PaymentMcp_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 2,
  "method": "tools/list",
  "params": {}
}

###

### Test 3: Submit Payment (Credit Card)
POST {{PaymentMcp_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 3,
  "method": "tools/call",
  "params": {
    "name": "SubmitPayment",
    "arguments": {
      "AccountId": "1000",
      "Description": "Electricity bill payment",
      "RecipientName": "Electric Company",
      "RecipientBankCode": "ELEC123",
      "Amount": "150.00",
      "Timestamp": "2026-01-12T10:30:00Z",
      "PaymentType": "creditcard",
      "PaymentMethodId": "12345"
    }
  }
}

###

### Test 4: Submit Payment (Bank Transfer)
POST {{PaymentMcp_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 4,
  "method": "tools/call",
  "params": {
    "name": "SubmitPayment",
    "arguments": {
      "AccountId": "1010",
      "Description": "Rent payment",
      "RecipientName": "Landlord Inc",
      "RecipientBankCode": "LAND456",
      "Amount": "1500.00",
      "Timestamp": "2026-01-12T10:35:00Z",
      "PaymentType": "banktransfer",
      "PaymentMethodId": "23456"
    }
  }
}

###

### Test 5: Submit Payment (Large Amount)
POST {{PaymentMcp_HostAddress}}/mcp
Content-Type: application/json
Accept: application/json, text/event-stream

{
  "jsonrpc": "2.0",
  "id": 5,
  "method": "tools/call",
  "params": {
    "name": "SubmitPayment",
    "arguments": {
      "AccountId": "1000",
      "Description": "Invoice payment",
      "RecipientName": "Supplier Corp",
      "RecipientBankCode": "SUPP789",
      "Amount": "5000.00",
      "Timestamp": "2026-01-12T10:40:00Z",
      "PaymentType": "banktransfer",
      "PaymentMethodId": "23456"
    }
  }
}

